# Copy this file to .env and populate values locally.
# Never commit .env or any real API keys/credentials to version control.

# Application runtime settings
APP_ENV=
APP_HOST=
APP_PORT=
CONFIG_PATH=

# Groq API (AI CV Evaluation)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Coda API
CODA_API_TOKEN=
CODA_DOC_ID=
CODA_TABLE_ID=

# Google Sheets / Google Drive / Google Cloud
GOOGLE_SHEETS_ID=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Sheet1
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_APPLICATION_CREDENTIALS=secrets/google-service-account.json

# Webhook authentication (Google Apps Script -> Python backend)
WEBHOOK_AUTH_TOKEN=
